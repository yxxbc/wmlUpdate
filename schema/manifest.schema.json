{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/yxxbc/wmlUpdate/main/schema/manifest.schema.json",
  "title": "wml-update self-hosted manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "app_id", "channel", "version", "assets"],
  "properties": {
    "schema_version": {"const": 1},
    "app_id": {"type": "string", "minLength": 1},
    "channel": {"type": "string", "minLength": 1},
    "version": {"type": "string", "description": "Strict SemVer 2.0.0."},
    "published_at": {"type": "string", "format": "date-time"},
    "notes": {"type": "string", "maxLength": 1048576},
    "mandatory": {"type": "boolean"},
    "assets": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["url", "sha256"],
        "properties": {
          "name": {"type": "string"},
          "os": {"type": "string"},
          "arch": {"type": "string"},
          "url": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"},
          "size": {"type": "integer", "minimum": 0},
          "format": {"type": "string"}
        }
      }
    }
  }
}
